{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@inithium/api-config": [
        "./libs/api/config/src/index.ts"
      ],
      "@inithium/api-database": [
        "./libs/api/database/src/index.ts"
      ],
      "@inithium/shared-contracts": [
        "./libs/shared/contracts/src/index.ts"
      ],
      "@inithium/shared-permissions": [
        "./libs/shared/permissions/src/index.ts"
      ],
      "@inithium/api-users": [
        "./libs/api/users/src/index.ts"
      ],
      "@inithium/api-auth": [
        "./libs/api/auth/src/index.ts"
      ],
      "@inithium/shared-data-access": [
        "./libs/shared/data-access/src/index.ts"
      ],
      "@inithium/cms-auth": [
        "./libs/cms/auth/src/index.ts"
      ],
      "@inithium/shared-ui-theme": [
        "./libs/shared/ui-theme/src/index.ts"
      ],
      "@inithium/shared-ui-components": [
        "./libs/shared/ui-components/src/index.ts"
      ],
      "@inithium/shared-ui-composites": [
        "./libs/shared/ui-composites/src/index.ts"
      ],
      "@inithium/api-settings": [
        "./libs/api/settings/src/index.ts"
      ],
      "@inithium/api-pages": [
        "./libs/api/pages/src/index.ts"
      ],
      "@inithium/shared-ui-layouts": [
        "./libs/shared/ui-layouts/src/index.ts"
      ],
      "@inithium/web-shell": [
        "./libs/web/shell/src/index.ts"
      ],
      "@inithium/web-pages": [
        "./libs/web/pages/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
