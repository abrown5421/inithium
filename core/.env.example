# Copy this file to .env (git-ignored) and fill in the values.
# On Render, set the same variables in the service's Environment settings instead.

# MongoDB connection string. Must include the database name after the host:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Interface and port the api listens on (defaults: localhost, 3000).
# Render needs HOST=0.0.0.0; it provides PORT itself.
# HOST=localhost
# PORT=3000
