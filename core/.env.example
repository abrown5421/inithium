# Copy this file to .env (git-ignored) and fill in the values.
# On Render, set the same variables in the service's Environment settings instead.

# MongoDB connection string. Must include the database name after the host:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# development (default) or production. Set production on Render: auth cookies are only marked Secure in production.
# NODE_ENV=development

# Interface and port the api listens on (defaults: localhost, 3000).
# Render needs HOST=0.0.0.0; it provides PORT itself.
# HOST=localhost
# PORT=3000

# Signs access tokens. At least 32 characters, unique per client. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Session lifetimes (defaults: 15 minutes, 30 days).
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=30

# The dev account created on startup when no dev user exists. Use a different temporary
# password for every client; it only applies until the account's password is changed.
SEED_DEV_EMAIL=
SEED_DEV_PASSWORD=

# Where uploaded files live (decision 0098):
#   database     the site's own MongoDB, no third party (default; 2 MB per file, capped in total below)
#   cloud-staff  Cloudflare R2 for staff uploads; members can't upload
#   cloud-all    Cloudflare R2 for everyone, members' avatars and banners included
# STORAGE_MODE=database
# The database mode's total cap for uploaded files, in MB (default 250).
# STORAGE_DATABASE_QUOTA_MB=250

# Cloudflare R2, required by the cloud modes. In the Cloudflare dashboard: R2 > your bucket, and
# R2 > Manage API tokens > Create (Object Read & Write on the bucket) for the two keys.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional: another endpoint (e.g. https://<account>.eu.r2.cloudflarestorage.com for an EU bucket).
# R2_ENDPOINT=
# Optional: the bucket's public address (r2.dev or a custom domain). Files are then sent from there,
# saving the api's bandwidth; add the safety headers there too (see the manual's Assets page).
# R2_PUBLIC_URL=
