{
  "name": "api-presence",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/presence/src",
  "projectType": "library",
  "tags": [
    "scope:api",
    "type:feature",
    "origin:core"
  ],
  "// targets": "to see all targets run: nx show project api-presence --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "{projectRoot}"
      }
    }
  }
}
