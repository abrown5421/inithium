{
  "name": "shared-ui-theme",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui-theme/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:ui",
    "origin:core",
    "ui:theme"
  ],
  "// targets": "to see all targets run: nx show project shared-ui-theme --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "{projectRoot}"
      }
    }
  }
}
